<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- FCM push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Advertising ID, used for ad attribution (Google Ads via Firebase
         Analytics, Adapty). Must match the "Advertising ID" declaration in
         Play Console, which is set to Yes. Without this permission Android 13+
         hands out an all-zero ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
    <application
        android:usesCleartextTraffic="true"
        android:label="Star Registration Planetarium"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Klaviyo push notifications with a shop link in the "Deep link"
                 field. Klaviyo opens a link to one of these hosts as a VIEW
                 intent aimed at this app; MainActivity records the tap and
                 passes the link on to the browser.
                 A link to any other website needs no entry here: Klaviyo finds
                 no activity for it, starts the app normally, and MainActivity
                 opens the link from the push's data instead.
                 BROWSABLE is left out on purpose: links tapped in a browser
                 carry that category and therefore never match, and it lets
                 MainActivity hand the link to the browser without it coming
                 straight back here. -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="https"/>
                <data android:host="www.star-registration.com"/>
                <data android:host="star-registration.com"/>
                <data android:host="www.sterntaufe-deutschland.de"/>
                <data android:host="sterntaufe-deutschland.de"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Adapty SDK Configuration -->
        <meta-data
            android:name="AdaptyPublicSdkKey"
            android:value="public_live_IOi0yFDb.WFTHrIKk8DzeTfEPmBwQ" />
        <meta-data
            android:name="AdaptyObserverMode"
            android:value="false" />
        <!-- Advertising ID collection is governed by consent, not switched
             off here: Google Analytics only reads it once ad_storage consent is
             granted (Consent Mode defaults below, updated by ConsentService),
             and Adapty is told at activation in main.dart. -->

        <!-- Google Consent Mode v2 defaults: denied until ConsentService
             grants (automatically outside EEA/UK/CH, or via the consent
             banner inside). Required by Google's EU User Consent Policy. -->
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- Disable Klaviyo advertising ID collection -->
        <meta-data
            android:name="com.klaviyo.core.networking.AnalyticsCollector.ADVERTISING_ID_ENABLED"
            android:value="false" />

        <!-- Let Klaviyo's Android SDK report "Opened Push" itself, at the moment
             of the tap, before it hands the tap on to MainActivity. Left unset,
             the klaviyo_flutter_sdk plugin reports the open every time
             MainActivity is attached with the push's intent, which counts the
             same tap again when Android restores the app from recents after
             ending its process. -->
        <meta-data
            android:name="com.klaviyo.push.automatic_push_open_tracking"
            android:value="true" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCc4LPIozIoEHVAMFz5uyQ_LrT1nAlbmfc" />

        <!-- PostHog Analytics — disable auto-init so we can configure the host manually -->
        <meta-data android:name="com.posthog.posthog.AUTO_INIT" android:value="false" />

        <!-- Klaviyo's push service is registered by the klaviyo_flutter_sdk
             plugin itself. Do not declare com.klaviyo.pushFcm.KlaviyoPushService
             here: a declaration in this file wins over the plugin's and breaks
             its handling. -->
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
